{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fagx blocklist payload (v0.1)",
  "description": "Canonical payload carried inside payload_b64. v0.1 contains institucional + prefijos only; community numbers belong to the v0.2 track. Institutional entries carry both delivery forms (numero, numero_e164) per criterio SEC-01 §6 / FAG-28.",
  "type": "object",
  "required": ["schema_version", "secuencia", "generado_en", "institucional", "prefijos"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "secuencia": { "type": "integer", "minimum": 1 },
    "generado_en": { "type": "integer", "minimum": 0, "description": "Unix epoch seconds (UTC)." },
    "institucional": {
      "type": "object",
      "required": ["numeros", "rangos"],
      "additionalProperties": false,
      "properties": {
        "numeros": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["numero", "numero_e164"],
            "additionalProperties": false,
            "properties": {
              "numero": { "type": "string", "pattern": "^600[0-9]{7}$" },
              "numero_e164": { "type": "string", "pattern": "^56600[0-9]{7}$" }
            }
          }
        },
        "rangos": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "object" },
          "description": "Institutional permit ranges (Fase 0 shape). Always empty in v0.1."
        }
      }
    },
    "prefijos": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["600", "809"] }
    }
  }
}
