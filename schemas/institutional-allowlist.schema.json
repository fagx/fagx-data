{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fagx-data/schemas/institutional-allowlist.schema.json",
  "title": "Fagx institutional allowlist (seed)",
  "description": "Proposed schema for validate.yml (BE-01). Source of truth for the format: docs/institutional-allowlist-criteria.md.",
  "type": "object",
  "required": [
    "formato",
    "pais",
    "criterio_version",
    "criterio",
    "actualizado_en",
    "entradas"
  ],
  "additionalProperties": true,
  "properties": {
    "formato": {
      "const": "fagx-institutional-allowlist/1"
    },
    "pais": {
      "const": "CL"
    },
    "criterio_version": {
      "type": "integer",
      "minimum": 1
    },
    "criterio": {
      "type": "string",
      "minLength": 1
    },
    "actualizado_en": {
      "type": "string",
      "format": "date-time"
    },
    "curado_por": {
      "type": "string"
    },
    "nota_formato": {
      "type": "string"
    },
    "entradas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/entrada"
      }
    }
  },
  "$defs": {
    "entrada": {
      "type": "object",
      "required": [
        "institucion",
        "categoria",
        "rol",
        "numero_display",
        "numero",
        "numero_e164",
        "fuente"
      ],
      "additionalProperties": false,
      "properties": {
        "institucion": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "categoria": {
          "enum": [
            "banco",
            "cooperativa",
            "aseguradora",
            "salud",
            "afp",
            "telecomunicaciones",
            "energia",
            "retail",
            "transporte",
            "gobierno"
          ]
        },
        "rol": {
          "enum": [
            "atencion-clientes",
            "emergencias",
            "venta",
            "salida-postventa",
            "asistencia-tecnica"
          ]
        },
        "numero_display": {
          "type": "string",
          "pattern": "^600[\\d ]{7,11}$"
        },
        "numero": {
          "type": "string",
          "pattern": "^600\\d{7}$"
        },
        "numero_e164": {
          "type": "string",
          "pattern": "^56600\\d{7}$"
        },
        "fuente": {
          "$ref": "#/$defs/fuente"
        },
        "notas": {
          "type": "string",
          "maxLength": 400
        }
      }
    },
    "fuente": {
      "type": "object",
      "required": [
        "tipo",
        "url",
        "verificado_en",
        "metodo"
      ],
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "enum": [
            "sitio-oficial",
            "centro-ayuda-oficial",
            "regulador"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "secundaria": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "verificado_en": {
          "type": "string",
          "format": "date"
        },
        "metodo": {
          "enum": [
            "fetch-directo",
            "contenido-indexado-del-dominio-oficial"
          ]
        }
      }
    }
  }
}
