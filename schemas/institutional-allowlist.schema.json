{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fagx institutional allowlist seed",
  "description": "data/institutional-allowlist.json — edited only by reviewed PRs (Security & Privacy as required reviewer for institutional edits). Numbers are fictitious in examples; real entries cite a public source and verification date.",
  "type": "object",
  "required": ["schema_version", "updated_at", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "updated_at": { "type": "string", "format": "date" },
    "criterio": {
      "type": "string",
      "description": "Documented inclusion criterion (SEC-01 owns the first curated PR)."
    },
    "fuente_indice": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Public index sources used for curation, with verification dates."
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["numero", "nombre", "categoria", "fuente", "verificado_en"],
        "additionalProperties": false,
        "properties": {
          "numero": { "type": "string", "pattern": "^600[0-9]{6}$" },
          "nombre": { "type": "string", "minLength": 1 },
          "categoria": {
            "enum": ["banco", "aseguradora", "servicio_publico", "salud", "gobierno", "telecom", "otro"]
          },
          "fuente": { "type": "string", "minLength": 1 },
          "verificado_en": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
